# Copy this file to .env, then edit the settings for your own services.
# .env is ignored by Git. Passwords and API keys go in secret files below.

# Browser access
# Exact browser origin, without a trailing slash. Match HOST_PORT for local use.
# For an HTTPS reverse proxy, use e.g. https://email-assist.example.com instead.
PUBLIC_ORIGIN=http://localhost:8000
WEB_USERNAME=admin
HOST_PORT=8000
# IANA timezone for the daily 07:00 inbox check.
TZ=UTC

# Proton Mail Bridge
# Leave blank when entering both Bridge credentials through the setup form.
# Set this to your Bridge IMAP username when using a secrets/imap-password file.
IMAP_USERNAME=

# AI service (required: replace both placeholders)
# API base URL, including its API prefix, without /chat/completions.
# The URL must be reachable from the app container; localhost means that container.
AI_BASE_URL=https://api.example.com/v1
AI_MODEL=your-model-name

# PostgreSQL
# Hostname must resolve on DATABASE_NETWORK. Provision this database and role.
PGHOST=postgres
PGDATABASE=email_assist
PGUSER=email_assist

# Docker networks (must already exist)
# Networks where your database and AI endpoint are reachable.
DATABASE_NETWORK=database
AI_NETWORK=ai

# Image name used for local builds by docker compose up --build.
# For a published image, use ghcr.io/<owner>/<repo>:latest or :sha-<commit-sha>.
EMAIL_ASSIST_IMAGE=email-assist:local

# Host storage (relative to the Compose file, or your own absolute paths)
# Create these directories and make them accessible to container UID 1000.
# Keep runtime data outside Git; the default directories are ignored.
SECRETS_DIR=./secrets
STATE_DIR=./state
SOCKET_DIR=./run

# Required files inside SECRETS_DIR (protect credentials with mode 600):
#   web-password     Strong, unique app login password.
#   db-password      Password for PGUSER.
#   ai-key           API key for AI_BASE_URL.
#   bridge-cert.pem  Certificate copied from your trusted local Bridge listener.
# Optional:
#   imap-password    Bridge-generated IMAP password, paired with IMAP_USERNAME.
# See README.md for network prerequisites, permissions, and certificate setup.
