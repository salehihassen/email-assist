# Copy this file to .env, then edit the settings for your own services.
# .env is ignored by Git. Passwords and API keys go in secret files below.

# Browser access
# Exact HTTPS browser origin, without a trailing slash. Session cookies require HTTPS.
PUBLIC_ORIGIN=https://email-assist.example.com
WEB_USERNAME=admin
HOST_PORT=8000
# IANA timezone for the daily 07:00 inbox check.
TZ=UTC

# Mail providers
# Providers can be added in the UI (Providers button), here, or both. List
# names here (lowercase letters, digits, hyphens), then set MAIL_<NAME>_*
# (uppercase, hyphens as underscores). Fields set here are locked in the UI.
#   _LABEL     Display name (defaults to the name)
#   _TYPE      imap (implicit TLS, default) or bridge (Proton Mail Bridge)
#   _HOST      IMAP host, required for imap; _PORT defaults to 993
#   _USERNAME  Mailbox login
#   _PASSWORD  Works, but secrets/<name>-imap-password keeps it out of docker inspect
#   _WEBMAIL   https:// link for "Open webmail"
#   _FOCUS     Extra scoring guidance for this inbox
MAIL_PROVIDERS=
# MAIL_PROVIDERS=proton,work
# MAIL_PROTON_LABEL=Personal
# MAIL_PROTON_TYPE=bridge
# MAIL_PROTON_WEBMAIL=https://mail.proton.me/
# MAIL_WORK_LABEL=Business
# MAIL_WORK_HOST=imappro.zoho.com
# MAIL_WORK_USERNAME=you@yourcompany.com
# MAIL_WORK_WEBMAIL=https://mail.zoho.com/
# MAIL_WORK_FOCUS=Prioritize clients, invoices, and contracts. Rank SaaS notifications and vendor marketing low.

# Upgrades from the single-mailbox version only: Bridge username for the
# migrated "proton" provider when state/imap-username is absent.
IMAP_USERNAME=

# AI service (required: replace both placeholders)
# API base URL, including its API prefix, without /chat/completions.
# The URL must be reachable from the app container; localhost means that container.
AI_BASE_URL=https://api.example.com/v1
AI_MODEL=your-model-name

# PostgreSQL
# Hostname must resolve on DATABASE_NETWORK. Provision this database and role.
PGHOST=postgres
PGDATABASE=email_assist
PGUSER=email_assist

# Docker networks (must already exist)
# Networks where your database and AI endpoint are reachable.
DATABASE_NETWORK=database
AI_NETWORK=ai

# Image name used for local builds by docker compose up --build.
# For a published image, use ghcr.io/<owner>/<repo>:latest or :sha-<commit-sha>.
EMAIL_ASSIST_IMAGE=email-assist:local

# Host storage (relative to the Compose file, or your own absolute paths)
# Create these directories and make them accessible to container UID 1000.
# Keep runtime data outside Git; the default directories are ignored.
SECRETS_DIR=./secrets
STATE_DIR=./state
SOCKET_DIR=./run

# Required files inside SECRETS_DIR (protect credentials with mode 600):
#   web-password     Strong, unique app login password (or provision its hash).
#   web-password-hash Recommended Argon2id hash; takes precedence when present.
#   db-password      Password for PGUSER.
#   ai-key           API key for AI_BASE_URL.
#   bridge-cert.pem  Certificate copied from your trusted local Bridge listener
#                    (only needed for bridge providers).
# Optional:
#   <name>-imap-password  Mailbox password for provider <name>; overrides
#                         MAIL_<NAME>_PASSWORD and passwords entered in the UI.
# See README.md for network prerequisites, permissions, and certificate setup.
