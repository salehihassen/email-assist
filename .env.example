# Browser-facing origin, without a trailing slash; required for POST requests.
PUBLIC_ORIGIN=https://email-assist.example.com
WEB_USERNAME=admin
# Optional when you enter both Bridge credentials through the UI.
IMAP_USERNAME=

# Replace these placeholders with your OpenAI-compatible endpoint and model.
AI_BASE_URL=https://api.example.com/v1
AI_MODEL=your-model-name
EMAIL_ASSIST_IMAGE=email-assist:local

# External Docker networks where your database and AI endpoint are reachable.
DATABASE_NETWORK=database
AI_NETWORK=ai
PGHOST=postgres
PGDATABASE=email_assist
PGUSER=email_assist

# Host-side storage directories; ignored by Git.
SECRETS_DIR=./secrets
STATE_DIR=./state
SOCKET_DIR=./run
HOST_PORT=8000
TZ=UTC

# Passwords, AI key and Bridge certificate belong in the mounted secrets
# directory, never in this file. See README.md for filenames.
